// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------
// HR Domain
// -----------------------------------------------------------------

model Employee {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. EMP-001
  name           String
  phoneNumber    String    @unique
  email          String    @unique
  departmentId   String?
  positionId     String?
  hireDate       DateTime
  status         String    @default("ACTIVE") // ACTIVE, PROBATION, RESIGNED

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?

  department     Department? @relation(fields: [departmentId], references: [id])
  contracts      Contract[]
}

model Department {
  id             String    @id @default(uuid())
  code           String    @unique
  name           String
  parentId       String?
  headcountLimit Int       @default(0)

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  employees      Employee[]
  parent         Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children       Department[] @relation("DepartmentHierarchy")
}

// -----------------------------------------------------------------
// Contract Domain
// -----------------------------------------------------------------

model Contract {
  id             String    @id @default(uuid())
  code           String    @unique // e.g. HT-2026-001
  counterpartyId String
  amount         Decimal
  signDate       DateTime
  startDate      DateTime
  endDate        DateTime
  status         String    @default("DRAFT") // DRAFT, ACTIVE, EXPIRED, CANCELLED
  ownerId        String

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  owner          Employee  @relation(fields: [ownerId], references: [id])
}
