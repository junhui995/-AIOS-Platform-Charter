generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------
// System Management & Permissions Domain
// -----------------------------------------------------------------

model Role {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  // Permissions based on functionality and organization dimension
  permissions RolePermission[]
  employees   Employee[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model RolePermission {
  id          String  @id @default(uuid())
  roleId      String
  module      String // e.g., HR, FINANCE, WORKFLOW
  action      String // READ, WRITE, ADMIN
  dimensionId String? // Links to OrgDimension for data scope limitation

  role      Role          @relation(fields: [roleId], references: [id])
  dimension OrgDimension? @relation(fields: [dimensionId], references: [id])
}

// -----------------------------------------------------------------
// Organization Architecture Domain
// -----------------------------------------------------------------

model OrgDimension {
  id          String  @id @default(uuid())
  code        String  @unique // COMPANY_DIMENSION, BUSINESS_DIMENSION
  name        String
  description String?

  departments Department[]
  permissions RolePermission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id             String  @id @default(uuid())
  dimensionId    String
  code           String  @unique
  name           String
  parentId       String?
  headcountLimit Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dimension OrgDimension @relation(fields: [dimensionId], references: [id])
  parent    Department?  @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children  Department[] @relation("DepartmentHierarchy")
  positions Position[]
  expenses  Expense[]
}

model Position {
  id            String   @id @default(uuid())
  departmentId  String
  code          String   @unique
  name          String
  level         String // Level for salary calculation e.g., P1, P2, M1
  baseSalaryRef Decimal? // Reference base salary for this position level

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  department Department         @relation(fields: [departmentId], references: [id])
  employees  EmployeePosition[]
}

// -----------------------------------------------------------------
// Employee Domain
// -----------------------------------------------------------------

model Employee {
  id            String   @id @default(uuid())
  code          String   @unique // e.g. EMP-001
  name          String
  phoneNumber   String   @unique
  email         String   @unique
  personalLevel String? // Personal level evaluating skill/tenure e.g., L3
  roleId        String? // System Role Binding
  hireDate      DateTime
  status        String   @default("ACTIVE") // ACTIVE, PROBATION, RESIGNED, DISABLED
  passwordHash  String? // scrypt$<salt>$<hash>; null = 未初始化（seed 置默认密码）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdBy String?
  updatedBy String?

  role             Role?               @relation(fields: [roleId], references: [id])
  positions        EmployeePosition[]
  contracts        LaborContract[]
  leaveRequests    LeaveRequest[]
  leaveBalance     LeaveBalance?
  salarySlips      SalarySlip[]
  benefits         EmployeeBenefit[]
  reviews          PerformanceReview[]
  PunchRecord      PunchRecord[]
  DailyAttendance  DailyAttendance[]
  expenses         Expense[]           @relation("ExpenseOwner")
  approvedExpenses Expense[]           @relation("ExpenseApprover")
}

// Junction table for many-to-many relationship between Employee and Position
model EmployeePosition {
  id         String   @id @default(uuid())
  employeeId String
  positionId String
  isPrimary  Boolean  @default(true)
  assignedAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
  position Position @relation(fields: [positionId], references: [id])

  @@unique([employeeId, positionId])
}

// -----------------------------------------------------------------
// Labor Contract Domain
// -----------------------------------------------------------------

model LaborContractTemplate {
  id            String  @id @default(uuid())
  name          String  @unique
  contentHtml   String // Template content
  watermarkText String?
  isActive      Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts LaborContract[]
}

model LaborContract {
  id         String   @id @default(uuid())
  code       String   @unique
  employeeId String
  templateId String?
  signDate   DateTime
  startDate  DateTime
  endDate    DateTime
  status     String   @default("ACTIVE") // DRAFT, ACTIVE, EXPIRED, TERMINATED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee               @relation(fields: [employeeId], references: [id])
  template LaborContractTemplate? @relation(fields: [templateId], references: [id])
}

// -----------------------------------------------------------------
// Performance Management Domain
// -----------------------------------------------------------------

model PerformanceTemplate {
  id         String @id @default(uuid())
  name       String
  targetType String // COMPANY, DEPARTMENT, EMPLOYEE
  metrics    Json // Configurable metrics and weights

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews PerformanceReview[]
}

model PerformanceReview {
  id         String   @id @default(uuid())
  employeeId String
  templateId String
  period     String // e.g., 2026-Q3
  score      Decimal?
  grade      String? // S, A, B, C
  status     String   @default("DRAFT") // DRAFT, IN_PROGRESS, COMPLETED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee            @relation(fields: [employeeId], references: [id])
  template PerformanceTemplate @relation(fields: [templateId], references: [id])
}

// -----------------------------------------------------------------
// Compensation & Salary Domain
// -----------------------------------------------------------------

model SalaryFormula {
  id          String  @id @default(uuid())
  targetType  String // COMPANY, DEPARTMENT, POSITION, EMPLOYEE
  targetId    String? // ID of specific dept/employee if applicable
  expression  String // e.g., "baseSalary + (performanceScore * 100) - deductions"
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SalarySlip {
  id         String    @id @default(uuid())
  employeeId String
  month      String // e.g., "2026-07"
  baseSalary Decimal   @db.Decimal(10, 2)
  bonus      Decimal   @default(0) @db.Decimal(10, 2)
  deductions Decimal   @default(0) @db.Decimal(10, 2)
  netPay     Decimal   @db.Decimal(10, 2)
  status     String    @default("DRAFT") // DRAFT, ISSUED
  issuedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, month])
}

// Benefit catalog + employee enrollment (C&B)
model BenefitItem {
  id          String  @id @default(uuid())
  code        String  @unique // e.g. MEDICAL, HOUSING_FUND, TRANSPORT
  name        String
  category    String // INSURANCE, ALLOWANCE, WELFARE
  periodCost  Decimal @default(0) @db.Decimal(10, 2) // monthly company cost
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments EmployeeBenefit[]
}

model EmployeeBenefit {
  id         String  @id @default(uuid())
  employeeId String
  itemId     String
  status     String  @default("ACTIVE") // ACTIVE, OPTED_OUT, TERMINATED
  startMonth String? // e.g. "2026-07"
  endMonth   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee    @relation(fields: [employeeId], references: [id])
  item     BenefitItem @relation(fields: [itemId], references: [id])

  @@unique([employeeId, itemId])
}

// -----------------------------------------------------------------
// Time & Attendance Domain
// -----------------------------------------------------------------

model LeaveRequest {
  id         String   @id @default(uuid())
  employeeId String
  leaveType  String // ANNUAL, SICK, UNPAID, MATERNITY
  startDate  DateTime
  endDate    DateTime
  reason     String?
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  aiAnalysis String? // Store AI reasoning for approval/rejection recommendations

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

model LeaveBalance {
  id          String @id @default(uuid())
  employeeId  String @unique
  annualTotal Int    @default(0) // In days or hours
  annualUsed  Int    @default(0)
  sickTotal   Int    @default(0)
  sickUsed    Int    @default(0)

  updatedAt DateTime @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id])
}

// -----------------------------------------------------------------
// Finance Expense Domain
// -----------------------------------------------------------------

model Expense {
  id           String    @id @default(uuid())
  code         String    @unique
  employeeId   String
  amount       Decimal   @db.Decimal(10, 2)
  reason       String
  category     String? // 报销类别: TRAVEL, TAXI, MEAL, OFFICE, OTHER
  occurredOn   DateTime? // 票据 / 发生日期
  departmentId String?
  status       String    @default("SUBMITTED") // SUBMITTED, PENDING_APPROVAL, APPROVED, REJECTED
  approvedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee   Employee    @relation("ExpenseOwner", fields: [employeeId], references: [id])
  department Department? @relation(fields: [departmentId], references: [id])
  approvedBy Employee?   @relation("ExpenseApprover", fields: [approvedById], references: [id])

  @@index([employeeId])
  @@index([status])
}

// -----------------------------------------------------------------
// Advanced Time & Attendance Domain (Schedules & Punch)
// -----------------------------------------------------------------

model SchedulePlan {
  id            String @id @default(uuid())
  name          String @unique // e.g. "Standard 9-to-6", "Night Shift"
  workTimeStart String // e.g. "09:00"
  workTimeEnd   String // e.g. "18:00"
  lateTolerance Int    @default(0) // minutes allowed to be late without penalty
  workDays      Int[] // e.g. [1,2,3,4,5] for Mon-Fri

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dailyRecords DailyAttendance[]
}

model PunchRecord {
  id         String   @id @default(uuid())
  employeeId String
  punchTime  DateTime
  punchType  String // IN, OUT
  source     String // WECHAT, GPS, WIFI
  deviceId   String?
  location   String?

  createdAt DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])
}

model DailyAttendance {
  id         String   @id @default(uuid())
  employeeId String
  date       DateTime @db.Date
  scheduleId String?

  punchInTime  DateTime?
  punchOutTime DateTime?

  status        String  @default("NORMAL") // NORMAL, LATE, EARLY_LEAVE, ABSENT, MISSED_PUNCH
  exceptionMemo String? // AI or system memo for the exception

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employee Employee      @relation(fields: [employeeId], references: [id])
  schedule SchedulePlan? @relation(fields: [scheduleId], references: [id])

  @@unique([employeeId, date])
}

// -----------------------------------------------------------------
// Workflow & BPM Domain
// -----------------------------------------------------------------

model WorkflowDefinition {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  nodes       Json // Stores the React Flow nodes mapping
  edges       Json // Stores the React Flow edges connection
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  versions WorkflowVersion[]
}

model WorkflowVersion {
  id           String   @id @default(uuid())
  definitionId String
  version      String
  nodes        Json
  edges        Json
  isPublished  Boolean  @default(false)
  createdAt    DateTime @default(now())

  definition WorkflowDefinition @relation(fields: [definitionId], references: [id])
  instances  ProcessInstance[]
}

model ProcessInstance {
  id           String    @id @default(uuid())
  versionId    String
  initiatorId  String?
  formData     Json
  currentNodes Json      @default("[]")
  status       String    @default("RUNNING") // RUNNING, COMPLETED, TERMINATED, CANCELLED
  startedAt    DateTime  @default(now())
  endedAt      DateTime?

  version WorkflowVersion @relation(fields: [versionId], references: [id])
  tasks   ProcessTask[]
  logs    ProcessLog[]
}

model ProcessTask {
  id             String    @id @default(uuid())
  instanceId     String
  nodeId         String
  nodeName       String
  taskType       String
  assigneeId     String?
  candidateGroup String?
  status         String    @default("PENDING") // PENDING, COMPLETED, REJECTED, CANCELLED
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

model ProcessLog {
  id         String   @id @default(uuid())
  instanceId String
  taskId     String?
  actionType String
  operatorId String?
  details    String? // Using String to hold comment, JSON could be used later
  createdAt  DateTime @default(now())

  instance ProcessInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
}

// -----------------------------------------------------------------
// HR Extension Domain: Grade & Training
// -----------------------------------------------------------------

model Grade {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. P6
  name           String // e.g. 资深
  salaryRangeMin Decimal
  salaryRangeMax Decimal?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Training {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. TRN-001
  name             String
  type             String // e.g. mandatory, optional, external
  completionStatus String   @default("PENDING")
  targetGroup      String? // Description of who is required
  skillTags        String[] // Stored as array of strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------
// Counterparty Domain
// -----------------------------------------------------------------

model Counterparty {
  id                 String  @id @default(uuid())
  code               String  @unique // e.g. CP-001
  companyName        String
  category           String // construction, design, service, material, consulting
  registeredCapital  String?
  qualificationGrade String?
  status             String  @default("APPROVED") // approved, pending, frozen
  socialCreditCode   String  @unique
  contactName        String?
  contactPhone       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bankAccounts BankAccount[]
  contracts    BusinessContract[]
  receipts     Receipt[]
  payments     Payment[]
  invoices     Invoice[]
}

model BankAccount {
  id             String @id @default(uuid())
  counterpartyId String
  bankName       String
  accountNumber  String

  counterparty Counterparty @relation(fields: [counterpartyId], references: [id])
}

// -----------------------------------------------------------------
// Business Contract Domain
// -----------------------------------------------------------------

model ContractTemplate {
  id           String  @id @default(uuid())
  code         String  @unique // e.g. TPL-001
  name         String
  version      String
  approvalFlow String?
  status       String  @default("ACTIVE") // active, inactive

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BusinessContract {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. HT-2026-001
  name               String
  counterpartyId     String
  amount             Decimal
  signDate           DateTime
  expiryDate         DateTime
  relatedProjectCode String?
  status             String   @default("DRAFT") // draft, approving, effective, executing, archived, completed, suspended, terminated, voided
  pushDownActions    String[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  counterparty Counterparty         @relation(fields: [counterpartyId], references: [id])
  supplements  ContractSupplement[]
  receipts     Receipt[]
  payments     Payment[]
  invoices     Invoice[]
  borrows      ContractBorrow[]
}

model ContractSupplement {
  id             String  @id @default(uuid())
  code           String  @unique // e.g. SUP-2026-001-01
  name           String
  mainContractId String
  amountDelta    Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mainContract BusinessContract @relation(fields: [mainContractId], references: [id])
}

model ContractBorrow {
  id                 String   @id @default(uuid())
  code               String   @unique // e.g. BW-001
  contractId         String
  borrowerName       String
  borrowDate         DateTime
  expectedReturnDate DateTime
  status             String   @default("BORROWING") // borrowing, returned, overdue

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract BusinessContract @relation(fields: [contractId], references: [id])
}

model PermissionTransfer {
  id                    String   @id @default(uuid())
  code                  String   @unique // e.g. TRF-001
  transferFrom          String
  transferTo            String
  transferContractCount Int      @default(0)
  transferDate          DateTime
  reason                String // resignation, transfer, promotion
  status                String   @default("PENDING") // completed, pending, rejected

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------
// Payment & Collection Domain
// -----------------------------------------------------------------

model Receipt {
  id                   String   @id @default(uuid())
  code                 String   @unique // e.g. RCP-001
  contractId           String
  counterpartyId       String
  amount               Decimal
  receiptDate          DateTime
  paymentMethod        String // bankTransfer, cash, check, other
  reconciliationStatus String   @default("UNRECONCILED") // reconciled, partial, unReconciled
  isOverdue            Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract     BusinessContract @relation(fields: [contractId], references: [id])
  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id])
}

model Payment {
  id             String   @id @default(uuid())
  code           String   @unique // e.g. PAY-001
  contractId     String
  counterpartyId String
  amount         Decimal
  paymentDate    DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract     BusinessContract @relation(fields: [contractId], references: [id])
  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id])
}

// -----------------------------------------------------------------
// Invoice Domain
// -----------------------------------------------------------------

model Invoice {
  id                        String  @id @default(uuid())
  invoiceNumber             String  @unique // e.g. 243456578
  contractId                String
  counterpartyId            String
  invoiceType               String // vatSpecial, vatGeneral, electronic
  amount                    Decimal
  taxRate                   Decimal // e.g. 9
  taxAmount                 Decimal
  totalWithTax              Decimal
  status                    String  @default("PENDING") // issued, pending, cancelled
  reconciliationMatchStatus String  @default("UNMATCHED") // matched, partialMatch, unMatched
  reconciliationDiff        Decimal @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contract     BusinessContract @relation(fields: [contractId], references: [id])
  counterparty Counterparty     @relation(fields: [counterpartyId], references: [id])
}

// -----------------------------------------------------------------
// Event Outbox Domain
// -----------------------------------------------------------------

model OutboxEvent {
  id          String    @id @default(uuid())
  eventType   String
  aggregate   String
  aggregateId String
  payload     Json
  status      String    @default("PENDING") // PENDING, PUBLISHED, FAILED
  attempts    Int       @default(0)
  lastError   String?
  createdAt   DateTime  @default(now())
  publishedAt DateTime?

  @@index([status])
  @@index([eventType])
}

// -----------------------------------------------------------------
// Warning & Alert Domain
// -----------------------------------------------------------------

model Alert {
  id               String   @id @default(uuid())
  code             String   @unique // e.g. WARN-20260724-001
  type             String // overduePayment, contractExpiry, attendanceAnomaly, probationExpiry, budgetOverrun
  level            String // high, medium, low
  title            String
  description      String
  triggerTime      DateTime
  triggerRule      String
  relatedObjectId  String
  status           String   @default("PENDING") // pending, processing, resolved
  availableActions String[] // Stored as array of strings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// -----------------------------------------------------------------
// Monitoring Rule Engine (phase A: backend-first)
// -----------------------------------------------------------------

model MonitorRule {
  id      String  @id @default(uuid())
  code    String  @unique // e.g. RULE-CONTRACT-EXPIRY
  name    String
  module  String // hr, finance, ops ...
  level   String  @default("medium") // high, medium, low
  enabled Boolean @default(true)

  target        String // registry entity key, e.g. laborContract, leaveRequest
  scopeFilter   Json? // optional static filter applied at query time
  conditionExpr String // DSL: field refs + operators + pure functions, evaluated per record
  schedule      Json // { kind: "interval", minutes: N } | { kind: "dailyAt", at: "HH:mm" } | { kind: "manual" }
  version       Int    @default(1)

  createdBy String?
  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lastRunAt DateTime?
  actions   MonitorRuleAction[]
  runs      RuleRunLog[]
}

model MonitorRuleAction {
  id     String      @id @default(uuid())
  ruleId String
  rule   MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  channel     String // inapp, email, dingtalk, wecom, webhook
  template    String // message template, supports {{field}} interpolation
  throttleSec Int     @default(0) // min gap between sends for the same related object
  enabled     Boolean @default(true)
}

model RuleRunLog {
  id     String      @id @default(uuid())
  ruleId String
  rule   MonitorRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  ranAt      DateTime @default(now())
  scanned    Int      @default(0)
  hit        Int      @default(0)
  raised     Int      @default(0)
  skipped    Int      @default(0)
  durationMs Int      @default(0)
  status     String // ok, error, cancelled
  cursor     Json?
  error      String?
}

model NotificationLog {
  id         String    @id @default(uuid())
  ruleId     String?
  channel    String // inapp, email, dingtalk, wecom, webhook
  alertId    String?
  target     String? // relatedObjectId or subject
  employeeId String? // in-app inbox owner (null = broadcast)
  title      String?
  body       String?
  readAt     DateTime?
  ok         Boolean
  error      String?
  sentAt     DateTime  @default(now())

  @@index([employeeId])
  @@index([channel])
}

model KnowledgeArticle {
  id          String    @id @default(uuid())
  title       String
  category    String // KNOWLEDGE_CATEGORIES: POLICY | HR | FINANCE | PROCESS | HOWTO
  summary     String?
  content     String
  tags        String[]  @default([])
  status      String    @default("DRAFT") // DRAFT | PUBLISHED
  authorId    String?
  authorName  String?
  viewCount   Int       @default(0)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([status])
}
